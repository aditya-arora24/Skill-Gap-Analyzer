  "label_quantiles": {
    "high_pct": 0.70,
    "low_pct":  0.30
  },
  "holdout_features": [
    "embedding_similarity",
    "weighted_skill_score",
    "title_similarity",
    "education_match"
  ],
  "training_features": [
    "tfidf_similarity",
    "skill_overlap",
    "num_missing_skills",
    "avg_missing_skill_importance",
    "years_of_experience",
    "experience_gap",
    "experience_relevance_score"
  ],
  "random_state": 42
}
